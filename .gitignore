sources/.env
venv/
unwanted/
__pycache__/

# ── Bulk data ────────────────────────────────────────────────────────────
# ml/data/ holds the raw training corpora (CubiCasa5K, RPLAN, the normalized
# extraction) — gigabytes, regenerable, never committed.
# data/ at the repo root is the OPPOSITE: small distilled stats the runtime
# reads (zone_patterns.json et al). That one IS tracked.
ml/data/

# ── Model weights & training artifacts (large binaries) ──────────────────
*.pt
*.npz
*.pkl
*.ckpt
ml/tier2_placer/weights/

# Large regenerable training/tuning artifacts. The small proof artifacts
# (manifest.json, gates_report.json, labels.json, tuned_config.json) stay
# tracked — they are the evidence, not the bulk.

ml/tuning/results/corpus.json
# Self-play corpus: regenerable bulk (ml.placer_v3.selfplay), and a partial
# smoke-test run must never be mistaken for the real thing. The manifest,
# which records the reward fingerprint the corpus was graded by, IS tracked.
ml/placer_v3/corpus/*.jsonl
ml/tuning/results/*.html

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# Pipeline output
output/

# IDE / OS
.vscode/
.idea/
*.pyc
.DS_Store
Thumbs.db

# The raw UI handoffs (design source, dev scripts, archives, screenshots)
# now live in unwanted/ui_handoff/, which is already ignored above.
# frontend/ is the built, shipped UI.
